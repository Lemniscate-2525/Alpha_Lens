# AlphaLens Production & Local Environment Configuration
APP_NAME="AlphaLens Financial RAG"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Database & Storage
VECTOR_STORE_TYPE="memory" # memory, chroma, or pgvector
DATABASE_URL="sqlite+aiosqlite:///data/alphalens.db"
REDIS_URL="redis://localhost:6379/0" # or rediss://... or fakeredis:// for testing
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
REDIS_KEY_PREFIX="alpha_lens"

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
USE_RERANKER=true

# Distributed Rate Limiter (Token Bucket with Lua Atomicity)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=50
RATE_LIMIT_REFILL_RATE=25
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_PREFIX="alpha_lens:ratelimit"
RATE_LIMIT_FAIL_CLOSED=true

# Distributed Singleflight Mutex
SINGLEFLIGHT_LEASE_MS=30000
SINGLEFLIGHT_WAIT_TIMEOUT_SECONDS=35.0
SINGLEFLIGHT_POLL_INTERVAL_MS=50

# Redis-Backed Exact & Semantic Cache
EXACT_CACHE_ENABLED=true
EXACT_CACHE_TTL_SECONDS=3600
EXACT_CACHE_PREFIX="alpha_lens:cache:exact"
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.94
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_PREFIX="alpha_lens:cache:semantic"
SEMANTIC_CACHE_MAX_ENTRIES=1000

# Asynchronous Ingestion Queue & Independent Workers
INGESTION_QUEUE_NAME="alpha_lens:queue:ingestion"
INGESTION_DEAD_LETTER_QUEUE="alpha_lens:queue:ingestion:dead_letter"
INGESTION_CONSUMER_GROUP="alpha_lens_workers"
INGESTION_MAX_RETRIES=3
INGESTION_WORKER_CONCURRENCY=2
INGESTION_JOB_TIMEOUT_SECONDS=1800

# LLM Provider Configuration
LLM_PROVIDER="ollama" # ollama, groq, triton, mock, or openai
LLM_MODEL_NAME="qwen3:1.7b"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL_NAME="qwen3:1.7b"
OLLAMA_TIMEOUT_SECONDS=60.0

# Triton Inference Server / TensorRT-LLM (Optional high-throughput cluster)
TRITON_SERVER_URL="http://localhost:8000"
TRITON_LLM_MODEL_NAME="tensorrt_llm"
TRITON_RERANKER_MODEL_NAME="cross_encoder_trt"

# API Authentication Key
MASTER_API_KEY="alpha-lens-master-key-prod-2025"
