# AlphaLens Environment Configuration
APP_NAME="AlphaLens Financial RAG"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Vector Store: memory, chroma, or pgvector
VECTOR_STORE_TYPE="memory"
DATABASE_URL="sqlite+aiosqlite:///data/alphalens.db"
REDIS_URL="redis://localhost:6379/0"

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
USE_RERANKER=true

# Two-Tier Caching & Rate Limiting
ENABLE_EXACT_CACHE=true
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_COSINE_THRESHOLD=0.94
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=25
RATE_LIMIT_BURST=50

# LLM Provider: mock, openai, groq, or anthropic
LLM_PROVIDER="mock"
LLM_MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""
GROQ_API_KEY=""
MASTER_API_KEY="alpha-lens-master-key-prod-2025"
